# ---------------------------------------------------------------------------
# ApexityEdu Smart Attendance Bridge — example configuration.
# Copy this file to ".env" and adjust values. NEVER put real secrets in this
# file in version control; the real .env is git-ignored.
# Secrets (EMS device token) are NOT stored here — they go into Windows
# Credential Manager via:  python -m apexity_bridge set-token
# ---------------------------------------------------------------------------

# ---- EMS (server side) ----
EMS_BASE_URL=https://apexityedu.com
# auto | iclock | rest  — auto probes which protocol the EMS actually speaks.
EMS_PROTOCOL=auto
# Path of the ZKTeco ADMS/iClock endpoint, if the EMS exposes one.
EMS_ICLOCK_PATH=/iclock
# How the bridge downloads the people directory (students + teachers + staff):
#   auto = use REST /api/v1/bridge/people whenever it answers (needed when the
#          push protocol is iClock, which has no roster download of its own)
#   rest = always use the REST endpoint
#   off  = never try (roster stays empty and the dashboard says why)
EMS_ROSTER_MODE=auto
# Publish each terminal's user table (PIN + name) to the EMS so a punch can be
# attributed to a real person. Never sends templates or passwords. (0/1)
EMS_PUSH_USERS=1
# Answer the READ-ONLY commands an ADMS server sends through getrequest
# (DATA QUERY USERINFO / DATA QUERY ATTLOG). Destructive commands are always
# refused. (0/1)
EMS_EXECUTE_COMMANDS=1
# Allow cleartext http for LOCAL development fixtures only (localhost only).
EMS_ALLOW_INSECURE_LOCALHOST=0
# EMS request timeout (seconds)
EMS_TIMEOUT=15

# ---- Local data storage ----
# Leave empty to use the platform default:
#   Windows: %ProgramData%\ApexityEduBridge\bridge.db
#   other:   ~/.apexity-bridge/bridge.db
BRIDGE_DB_PATH=
BRIDGE_DATA_DIR=

# ---- Local dashboard ----
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8321
# 0 = localhost-only (recommended). 1 = allow LAN access (requires firewall review).
DASHBOARD_ALLOW_LAN=0

# ---- Device timezone (the clock the K40 terminals are set to) ----
DEVICE_TIMEZONE=Asia/Dhaka

# ---- LAN discovery ----
# Comma-separated extra CIDR ranges to scan (interfaces' own subnets are always scanned).
DISCOVERY_EXTRA_SUBNETS=
# Seconds between full LAN re-discovery passes (detects changed IPs).
DISCOVERY_INTERVAL=300
# Max concurrent connection probes during a scan (rate limiting).
DISCOVERY_CONCURRENCY=32
# Use ICMP echo as an optional discovery aid (0/1). TCP probing is always used.
DISCOVERY_USE_PING=0
# Additional TCP ports to probe (port 4370 is always probed).
DISCOVERY_PORTS=

# ---- Attendance collection ----
# Seconds between device polls per online device.
COLLECT_INTERVAL=30
# Device communication timeout (seconds).
DEVICE_TIMEOUT=10
# Default ZKTeco comm key (0 = none). Per-device overrides are stored in the DB.
DEVICE_COMM_KEY=0

# ---- Sync ----
# Base delay (seconds) for exponential backoff retries of EMS pushes.
SYNC_RETRY_BASE=30
# Max retry delay (seconds).
SYNC_RETRY_MAX=1800
# How often (seconds) to refresh the people roster (students + teachers +
# staff) from the EMS.
ROSTER_INTERVAL=900
# How often (seconds) to read each terminal's user table and republish it if
# it changed.
USERS_SYNC_INTERVAL=900
# Max events per EMS push batch.
SYNC_BATCH_SIZE=100

# ---- Logging ----
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_DIR=
